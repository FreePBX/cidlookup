#!/usr/bin/php -q
<?php
  $restrict_mods = true;
  if (!@include_once(getenv('FREEPBX_CONF') ? getenv('FREEPBX_CONF') : '/etc/freepbx.conf')) {
    include_once('/etc/asterisk/freepbx.conf');
  }

 $agidir   = FreePBX::Config()->get('ASTAGIDIR');
 $lookupid = isset($argv[1]) ? $argv[1] : '';
 $number   = isset($argv[2]) ? (string) $argv[2] : '';
 $cidlook = FreePBX::Cidlookup()->getOne($lookupid);
 require_once $agidir."/phpagi.php";
 $agi      = new AGI();

  // Inbound CALLERID(num) is attacker-controlled. The admin query embeds
  // [NUMBER] inside SQL string literals (for example WHERE number = '[NUMBER]'
  // or LIKE '%[NUMBER]%'), so the token cannot be replaced with a bound '?'.
  // Allow only a phone number, then escape it with the remote server's quoting
  // rules before it is interpolated. prepare() runs on that finished SQL.
  if (!preg_match('/^[0-9+*#]+\z/', $number)) {
    $agi->verbose('--- Error: Rejected caller number for MySQL CID lookup ----');
    exit(0);
  }

  // get all infromation from database instead of passing through AGI

  if (empty($cidlook) || !is_array($cidlook)) {
    $agi->verbose('--- Error: CID lookup source not found. ----');
    exit(1);
  }

  $host     = trim((string) ($cidlook['mysql_host'] ?? ''));
  $port     = trim((string) ($cidlook['mysql_port'] ?? ''));
  $port     = $port === '' ? "3306" : $port;
  $username = trim((string) ($cidlook['mysql_username'] ?? ''));
  $password = trim((string) ($cidlook['mysql_password'] ?? ''));
  $dbname   = trim((string) ($cidlook['mysql_dbname'] ?? ''));
  $charset_raw = trim((string) ($cidlook['mysql_charset'] ?? ''));
  $charset  = $charset_raw === '' ? "" : ";charset=".$charset_raw;
  $template = (string) ($cidlook['mysql_query'] ?? '');
  $error    = "";
  $error    = empty($host)      ? $error.", host"      : $error."";
  $error    = empty($dbname)    ? $error.", dbname"    : $error."";
  $error    = empty($username)  ? $error.", username"  : $error."";
  $error    = empty($template)  ? $error.", query"     : $error."";

  if($error != ""){
    $agi->verbose('--- Error: Missing argument'.$error.'. ----');
    exit(1);
  }

  try {
    $options = array(PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION);
    // Stacked queries are not part of CID lookup. Force them off where the driver allows it.
    if (defined('PDO::MYSQL_ATTR_MULTI_STATEMENTS')) {
      $options[PDO::MYSQL_ATTR_MULTI_STATEMENTS] = false;
    }
    $remotepdo    = new PDO("mysql:host=$host;port=$port;dbname=$dbname$charset", $username, $password, $options);

    // quote() returns a fully quoted literal. Strip the wrapping quotes because
    // the saved template already supplies them around [NUMBER].
    $quoted = $remotepdo->quote($number);
    if ($quoted === false || strlen($quoted) < 2 || $quoted[0] !== "'" || substr($quoted, -1) !== "'") {
      $agi->verbose('--- Error: Could not quote caller number ----');
      exit(1);
    }
    $query  = str_replace('[NUMBER]', substr($quoted, 1, -1), $template);

    $stm    = $remotepdo->prepare($query);
    $stm->execute();
    $ret    = $stm->fetch(\PDO::FETCH_ASSOC);
  } catch (Exception $e) {
      dbug($e->getMessage());
      $agi->verbose('--- Error: MySQL CID lookup failed. ----');
      exit(1);
  }

  $name = null;
  if (is_array($ret)) {
    foreach($ret as $key => $val){
      $name   = $val;
      break;
    }
  }

  if(isset($name) && is_string($name)){
      $agi->set_variable("CALLERID(name)", $name);
  }
  else{
    $agi->verbose('--- Name not found ----');
  }

  exit(0);
